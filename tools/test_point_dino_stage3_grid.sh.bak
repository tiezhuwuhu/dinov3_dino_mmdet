#!/usr/bin/env bash
set -euo pipefail

ROOT="/root/autodl-tmp/dinov3_dino_mmdet"
MMDET="${ROOT}/mmdetection"
CONFIG_DIR="${MMDET}/configs/dino"
WORK_ROOT="${ROOT}/work_dirs/stage3_grid"

RESULT_CSV="${WORK_ROOT}/stage3_grid_results.csv"
RESULT_MD="${WORK_ROOT}/stage3_grid_results.md"

export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
export PYTHONPATH="${MMDET}:${PYTHONPATH:-}"

cd "${MMDET}"

LAMBDAS=("000" "005" "010" "020")
COSTS=("05" "10" "15" "20")

mkdir -p "${WORK_ROOT}"

echo "============================================================"
echo "Point-DINO Stage 3 Grid: Test Best Checkpoints"
echo "============================================================"


# ============================================================
# 1. Test every best checkpoint
# ============================================================

for LTAG in "${LAMBDAS[@]}"; do
    for CTAG in "${COSTS[@]}"; do

        EXP_NAME="point_dino_stage3_lam${LTAG}_cost${CTAG}"

        CONFIG="${CONFIG_DIR}/${EXP_NAME}.py"
        EXP_DIR="${WORK_ROOT}/${EXP_NAME}"
        TEST_LOG="${EXP_DIR}/best_test.log"

        echo
        echo "============================================================"
        echo "Experiment: ${EXP_NAME}"
        echo "============================================================"

        if [[ ! -f "${CONFIG}" ]]; then
            echo "[ERROR] Config not found:"
            echo "${CONFIG}"
            continue
        fi

        if [[ ! -d "${EXP_DIR}" ]]; then
            echo "[ERROR] Work directory not found:"
            echo "${EXP_DIR}"
            continue
        fi

        CKPT=$(find "${EXP_DIR}" \
            -maxdepth 1 \
            -type f \
            -name 'best_point_f1@8px_epoch_*.pth' \
            | sort -V \
            | tail -n 1 || true)

        if [[ -z "${CKPT}" ]]; then
            echo "[ERROR] Best checkpoint not found."
            continue
        fi

        echo "Best checkpoint:"
        echo "${CKPT}"

        # ----------------------------------------------------
        # 如果已经测试过，并且日志中包含完整 PointMetric，
        # 就直接使用已有结果，避免重复测试。
        # ----------------------------------------------------

        if [[ -f "${TEST_LOG}" ]] && \
           grep -q 'point/f1@4px:' "${TEST_LOG}" && \
           grep -q 'point/f1@8px:' "${TEST_LOG}"; then

            echo "[CACHE] Existing best_test.log found."
            echo "Skip testing."

        else

            echo "Testing best checkpoint..."

            python tools/test.py \
                "${CONFIG}" \
                "${CKPT}" \
                2>&1 | tee "${TEST_LOG}"
        fi

    done
done


# ============================================================
# 2. Parse all logs and generate CSV + Markdown matrix
# ============================================================

python - <<'PY'

from pathlib import Path
import re
import csv

ROOT = Path("/root/autodl-tmp/dinov3_dino_mmdet")
WORK_ROOT = ROOT / "work_dirs" / "stage3_grid"

lambdas = [
    ("000", 0.00),
    ("005", 0.05),
    ("010", 0.10),
    ("020", 0.20),
]

costs = [
    ("05", 5),
    ("10", 10),
    ("15", 15),
    ("20", 20),
]

csv_path = WORK_ROOT / "stage3_grid_results.csv"
md_path = WORK_ROOT / "stage3_grid_results.md"


metric_names = [
    "precision@4px",
    "recall@4px",
    "f1@4px",
    "mean_localization_error@4px",
    "tp@4px",
    "fp@4px",
    "fn@4px",
    "precision@8px",
    "recall@8px",
    "f1@8px",
    "mean_localization_error@8px",
    "tp@8px",
    "fp@8px",
    "fn@8px",
]


def extract_metrics(log_path):
    if not log_path.exists():
        return None

    text = log_path.read_text(
        encoding="utf-8",
        errors="ignore"
    )

    # 取最后一条完整测试结果
    lines = [
        line for line in text.splitlines()
        if "point/f1@4px:" in line
        and "point/f1@8px:" in line
    ]

    if not lines:
        return None

    line = lines[-1]

    result = {}

    for name in metric_names:

        pattern = rf"point/{re.escape(name)}:\s+([0-9.eE+-]+)"
        match = re.search(pattern, line)

        if match:
            value = float(match.group(1))

            if name.startswith(("tp@", "fp@", "fn@")):
                value = int(round(value))

            result[name] = value

    return result


rows = []
matrix = {}

for ltag, lam in lambdas:

    matrix[lam] = {}

    for ctag, cost in costs:

        exp_name = f"point_dino_stage3_lam{ltag}_cost{ctag}"
        exp_dir = WORK_ROOT / exp_name
        log_path = exp_dir / "best_test.log"

        metrics = extract_metrics(log_path)

        ckpts = sorted(
            exp_dir.glob("best_point_f1@8px_epoch_*.pth")
        )

        ckpt = str(ckpts[-1]) if ckpts else ""

        if metrics is None:

            print(
                f"[WARNING] Metrics missing: "
                f"lambda={lam}, cost={cost}"
            )

            matrix[lam][cost] = None

            rows.append({
                "lambda": lam,
                "PointL1Cost": cost,
                "checkpoint": ckpt,
            })

            continue

        row = {
            "lambda": lam,
            "PointL1Cost": cost,
            "checkpoint": ckpt,
        }

        row.update(metrics)

        rows.append(row)
        matrix[lam][cost] = metrics


# ============================================================
# CSV
# ============================================================

fieldnames = [
    "lambda",
    "PointL1Cost",
    "precision@4px",
    "recall@4px",
    "f1@4px",
    "mean_localization_error@4px",
    "precision@8px",
    "recall@8px",
    "f1@8px",
    "mean_localization_error@8px",
    "tp@4px",
    "fp@4px",
    "fn@4px",
    "tp@8px",
    "fp@8px",
    "fn@8px",
    "checkpoint",
]

with csv_path.open(
    "w",
    newline="",
    encoding="utf-8"
) as f:

    writer = csv.DictWriter(
        f,
        fieldnames=fieldnames
    )

    writer.writeheader()

    for row in rows:
        writer.writerow(row)


# ============================================================
# Markdown: main 4x4 F1 table
# ============================================================

lines = []

lines.append(
    "# Point-DINO Stage 3: λ × PointL1Cost Ablation"
)
lines.append("")

lines.append(
    "All experiments use native 1024×768 input, "
    "Point DN noise = 0.01 and FocalLossCost = 2."
)
lines.append("")

lines.append(
    "Each cell is **F1@4 / F1@8 (%)**."
)
lines.append("")

header = (
    "| Euclidean λ ↓ / PointL1Cost → | "
    + " | ".join(str(c) for _, c in costs)
    + " |"
)

separator = (
    "|---:|"
    + "|".join("---:" for _ in costs)
    + "|"
)

lines.append(header)
lines.append(separator)

for _, lam in lambdas:

    cells = []

    for _, cost in costs:

        m = matrix[lam].get(cost)

        if m is None:
            cells.append("—")
        else:
            f4 = m["f1@4px"] * 100
            f8 = m["f1@8px"] * 100

            cells.append(
                f"{f4:.2f} / {f8:.2f}"
            )

    lines.append(
        f"| **{lam:.2f}** | "
        + " | ".join(cells)
        + " |"
    )


# ============================================================
# Separate F1@4 matrix
# ============================================================

lines.append("")
lines.append("## F1@4 (%)")
lines.append("")

lines.append(
    "| λ ↓ / Cost → | "
    + " | ".join(str(c) for _, c in costs)
    + " |"
)

lines.append(separator)

for _, lam in lambdas:

    cells = []

    for _, cost in costs:

        m = matrix[lam].get(cost)

        if m is None:
            cells.append("—")
        else:
            cells.append(
                f"{m['f1@4px'] * 100:.2f}"
            )

    lines.append(
        f"| **{lam:.2f}** | "
        + " | ".join(cells)
        + " |"
    )


# ============================================================
# Separate F1@8 matrix
# ============================================================

lines.append("")
lines.append("## F1@8 (%)")
lines.append("")

lines.append(
    "| λ ↓ / Cost → | "
    + " | ".join(str(c) for _, c in costs)
    + " |"
)

lines.append(separator)

for _, lam in lambdas:

    cells = []

    for _, cost in costs:

        m = matrix[lam].get(cost)

        if m is None:
            cells.append("—")
        else:
            cells.append(
                f"{m['f1@8px'] * 100:.2f}"
            )

    lines.append(
        f"| **{lam:.2f}** | "
        + " | ".join(cells)
        + " |"
    )


# ============================================================
# MLE@4 matrix
# ============================================================

lines.append("")
lines.append("## MLE@4 (px)")
lines.append("")

lines.append(
    "| λ ↓ / Cost → | "
    + " | ".join(str(c) for _, c in costs)
    + " |"
)

lines.append(separator)

for _, lam in lambdas:

    cells = []

    for _, cost in costs:

        m = matrix[lam].get(cost)

        if m is None:
            cells.append("—")
        else:
            cells.append(
                f"{m['mean_localization_error@4px']:.4f}"
            )

    lines.append(
        f"| **{lam:.2f}** | "
        + " | ".join(cells)
        + " |"
    )


# ============================================================
# MLE@8 matrix
# ============================================================

lines.append("")
lines.append("## MLE@8 (px)")
lines.append("")

lines.append(
    "| λ ↓ / Cost → | "
    + " | ".join(str(c) for _, c in costs)
    + " |"
)

lines.append(separator)

for _, lam in lambdas:

    cells = []

    for _, cost in costs:

        m = matrix[lam].get(cost)

        if m is None:
            cells.append("—")
        else:
            cells.append(
                f"{m['mean_localization_error@8px']:.4f}"
            )

    lines.append(
        f"| **{lam:.2f}** | "
        + " | ".join(cells)
        + " |"
    )


# ============================================================
# Find best
# ============================================================

valid_rows = [
    r for r in rows
    if "f1@4px" in r and "f1@8px" in r
]

if valid_rows:

    best4 = max(
        valid_rows,
        key=lambda x: x["f1@4px"]
    )

    best8 = max(
        valid_rows,
        key=lambda x: x["f1@8px"]
    )

    lines.append("")
    lines.append("## Best Results")
    lines.append("")

    lines.append(
        f"- Best F1@4: "
        f"λ={best4['lambda']}, "
        f"Cost={best4['PointL1Cost']}, "
        f"F1@4={best4['f1@4px'] * 100:.2f}%"
    )

    lines.append(
        f"- Best F1@8: "
        f"λ={best8['lambda']}, "
        f"Cost={best8['PointL1Cost']}, "
        f"F1@8={best8['f1@8px'] * 100:.2f}%"
    )


md_path.write_text(
    "\n".join(lines) + "\n",
    encoding="utf-8"
)


# ============================================================
# Print main table to terminal
# ============================================================

print()
print("=" * 80)
print("Stage 3: F1@4 / F1@8 (%)")
print("=" * 80)

print(
    f"{'lambda':>8}"
    + "".join(
        f"{('Cost=' + str(c)):>20}"
        for _, c in costs
    )
)

for _, lam in lambdas:

    row_text = f"{lam:>8.2f}"

    for _, cost in costs:

        m = matrix[lam].get(cost)

        if m is None:
            cell = "N/A"
        else:
            cell = (
                f"{m['f1@4px']*100:.2f}"
                f" / "
                f"{m['f1@8px']*100:.2f}"
            )

        row_text += f"{cell:>20}"

    print(row_text)


if valid_rows:

    print()
    print("=" * 80)

    print(
        "Best F1@4:"
        f" lambda={best4['lambda']},"
        f" cost={best4['PointL1Cost']},"
        f" F1@4={best4['f1@4px']*100:.2f}%"
    )

    print(
        "Best F1@8:"
        f" lambda={best8['lambda']},"
        f" cost={best8['PointL1Cost']},"
        f" F1@8={best8['f1@8px']*100:.2f}%"
    )


print()
print("CSV:")
print(csv_path)

print()
print("Markdown:")
print(md_path)

PY


echo
echo "============================================================"
echo "STAGE 3 GRID SUMMARY FINISHED"
echo "============================================================"

echo
echo "Markdown result:"
echo "${RESULT_MD}"

echo
echo "CSV result:"
echo "${RESULT_CSV}"

echo
echo "============================================================"